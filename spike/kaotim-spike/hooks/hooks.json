{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" sessionStart" }],
    "sessionEnd": [{ "command": "python3 ./scripts/spike_hook.py sessionEnd" }],
    "preToolUse": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" preToolUse", "matcher": "Write|Delete|Shell|Task" }],
    "postToolUse": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" postToolUse", "matcher": "Task" }],
    "beforeShellExecution": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" beforeShellExecution" }],
    "afterShellExecution": [{ "command": "python3 ./scripts/spike_hook.py afterShellExecution" }],
    "afterFileEdit": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" afterFileEdit" }],
    "subagentStart": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" subagentStart" }],
    "subagentStop": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" subagentStop" }],
    "preCompact": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" preCompact" }],
    "stop": [{ "command": "python3 \"${CURSOR_PLUGIN_ROOT}/scripts/spike_hook.py\" stop", "loop_limit": 1 }]
  }
}
